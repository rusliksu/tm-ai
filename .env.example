# Copy to .env and fill in. Load with `source .env` (never read .env directly).
# Secrets live ONLY here; .env is gitignored.

# --- AI server (tm-ai-server) -------------------------------------------------
# OpenRouter is the only LLM backend. Required for all model calls.
OPENROUTER_API_KEY=sk-or-...

# Default model (any vendor/model id). Per-player override via POST /player/register.
# OPENROUTER_MODEL=anthropic/claude-opus-4-7

# Optional LLM tuning (see CLAUDE.md / specs/TM-AI.md for the full table):
# OPENROUTER_THINKING=auto                 # global reasoning override: auto | off (faster) | on
# OPENROUTER_THINKING_BUDGET=1024          # setup / per-generation reflection
# OPENROUTER_ACTION_THINKING_BUDGET=512    # tactical action turns
# OPENROUTER_MAX_OUTPUT_TOKENS=4096        # must exceed the thinking budget
# TM_AI_ACTION_CONTRACT=legacy             # legacy | compare | v2; v2 currently targets AndOptions
# LLM_DEBUG=true                           # log prompts + responses

# --- Sentry (optional, privacy-safe error monitoring) ------------------------
# The DSN is public project routing data, not an auth token. Keep it env-gated.
# TM_AI_SENTRY_DSN=https://public@example.com/1
# TM_AI_SENTRY_ENVIRONMENT=staging
# TM_AI_SENTRY_RELEASE=<git SHA>

# Cross-restart per-player state persistence:
# LLM_STATE_PERSIST=true
# LLM_STATE_DIR=./logs/llm-state
# LLM_STATE_MAX_AGE_DAYS=7

# --- TM game server (../terraforming-mars) ------------------------------------
AI_SERVER_URL=http://localhost:8000
# AI_TIMEOUT_MS=600000                      # HTTP timeout for /move (LLMs can be slow)

# --- Death-match driver (optional) --------------------------------------------
# DEATH_MATCH_MODELS=anthropic/claude-sonnet-4-6,openai/gpt-4o-mini,google/gemini-2.5-flash,deepseek/deepseek-chat
