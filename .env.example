# Copy to .env and fill in. Load with `source .env` (never read .env directly).
# Secrets live ONLY here; .env is gitignored.

# --- AI server (tm-ai-server) -------------------------------------------------
# OpenRouter is the cloud LLM gateway. The provider is derived from the model
# name: "vendor/model" → OpenRouter, "bare:tag" → local Ollama. No LLM_PROVIDER.
OPENROUTER_API_KEY=sk-or-...

# Path to the trained policy/value checkpoint (neural-net mode).
MODEL_PATH=../models/checkpoint_best.pt

# Optional LLM overrides (see CLAUDE.md "LLM Player" table for the full list):
# OPENROUTER_MODEL=google/gemini-2.5-flash-lite
# OLLAMA_MODEL=qwen3:4b
# USE_LLM=true
# LLM_DEBUG=true

# --- TM game server (../terraforming-mars) ------------------------------------
AI_SERVER_URL=http://localhost:8000
AI_TRAINING_LOG_DIR=./logs/training
